<?xml version="1.0"?>
<ruleset name="Magento2CacheWarmer">
    <description>PSR-12 coding standard for Magento2CacheWarmer.</description>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <severity>0</severity>
    </rule>
    <file>src</file>
    <file>tests</file>
    <file>bin</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
