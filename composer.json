{
    "name": "rafafortes/magento2-cache-warmer",
    "description": "A modular Magento 2 cache warmer.",
    "autoload": {
        "psr-4": {
            "Magento2CacheWarmer\\": "src/"
        }
    },
    "bin": [
        "bin/magento2-cache-warmer"
    ],
    "autoload-dev": {
        "psr-4": {
            "Magento2CacheWarmer\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.9",
        "phpmd/phpmd": "^2.15"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --testdox",
        "quality": [
            "@phpstan",
            "@phpcs",
            "@phpmd",
            "@security-audit",
            "@test-coverage"
        ],
        "phpstan": "phpstan analyse --configuration=phpstan.neon",
        "phpcs": "phpcs --standard=phpcs.xml src tests bin",
        "phpmd": "phpmd src text phpmd.xml",
        "security-audit": "composer audit --no-interaction",
        "test-coverage": [
            "@php -r \"if (is_file('build/coverage.xml')) { unlink('build/coverage.xml'); }\"",
            "phpunit --configuration phpunit.xml --coverage-text --coverage-clover=build/coverage.xml"
        ]
    },
    "config": {
        "platform": {
            "php": "8.0.0"
        },
        "sort-packages": true
    },
    "license": "MIT"
}
